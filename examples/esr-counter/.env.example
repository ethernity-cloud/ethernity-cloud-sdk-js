# esr-counter example configuration (the JS SDK reads .env; copy to .env)
PROJECT_NAME=esr-counter
SERVICE_TYPE=Nodenithy
BLOCKCHAIN_NETWORK=Bloxberg_Testnet
TRUSTED_ZONE_IMAGE=etny-nodenithy-testnet
IPFS_ENDPOINT=https://ipfs.ethernity.cloud
# Enable the Enclave State Registry; ecld-build resolves the per-network
# registry address itself -- do not hand-wire ECLD_ESR_CONTRACT.
ECLD_ESR_ENABLE=true
# PRIVATE_KEY=0x...   # only needed for ecld-publish / ecld-run (funded key)
