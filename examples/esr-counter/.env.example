# esr-counter example configuration (the JS SDK reads .env; copy to .env)
PROJECT_NAME=esr-counter
SERVICE_TYPE=Nodenithy
BLOCKCHAIN_NETWORK=Bloxberg_Testnet
TRUSTED_ZONE_IMAGE=etny-nodenithy-testnet
# Empty: the publish runs its own IPFS node and the dApp uses the bootnode's payload intake; an IPFS API of your own goes here (IPFS_TOKEN: its Authorization header).
IPFS_ENDPOINT=
# Enable the Enclave State Registry; ecld-build resolves the per-network
# registry address itself -- do not hand-wire ECLD_ESR_CONTRACT.
ECLD_ESR_ENABLE=true
# The funded key ecld-publish and ecld-run sign with: ecld-publish asks for it
# and a password and writes ENC_PRIVATE_KEY (the key encrypted under that
# password) and WALLET_ADDRESS here; it writes no PRIVATE_KEY. Without a
# terminal, set ECLD_PRIVATE_KEY and ECLD_KEY_PASSWORD in the environment.
