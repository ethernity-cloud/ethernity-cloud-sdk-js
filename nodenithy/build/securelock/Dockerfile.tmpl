# SCONE_NODE (build.mjs passes it) is the nodenithy trustedzone image this
# securelock is bundled with: node:22-alpine with the SCONE 6.0.7 runtime and
# CLI (sconecuratedimages/node:node-22-alpine, the base the etny-nodenithy CI
# builds the trustedzones on), the release the trustedzones, the LAS and the
# CAS run. Its own enclave is replaced below: /lib/libbinary-fs.so is
# overwritten and /usr/local/bin/node re-signed.
ARG SCONE_NODE

# The dependencies are plain JavaScript, installed with a stock node of the
# same major version; no SCONE binary runs at build time.
FROM node:22-alpine AS deps

COPY ./src /etny-securelock/
WORKDIR /etny-securelock
RUN npm install

FROM ${SCONE_NODE} AS release

# As in the runtime release stage: the scone CLI below runs on a build host
# without SGX.
ENV SCONE_MODE=SIM
ENV SCONE_LOG=DEBUG
ENV ENCLAVE_NAME_SECURELOCK=__ENCLAVE_NAME_SECURELOCK__
# "mainnet" or "testnet": the securelock self-signs from MR_ENCLAVE on a
# testnet without a ValidatorRegistry, and takes its certificate from the CAS
# otherwise.
ENV NETWORK_TYPE=__NETWORK_TYPE__
ENV BUCKET_NAME=__BUCKET_NAME__
ENV SMART_CONTRACT_ADDRESS=__SMART_CONTRACT_ADDRESS__
ENV IMAGE_REGISTRY_ADDRESS=__IMAGE_REGISTRY_ADDRESS__
ENV RPC_URL=__RPC_URL__
ENV CHAIN_ID=__CHAIN_ID__
ENV VALIDATOR_REGISTRY_ADDRESS=__ETNY_VALIDATOR_REGISTRY_ADDRESS__
# ESR (RFC §5.4): rendered by build.mjs to `ENV ESR_CONTRACT_ADDRESS=0x...` only
# when ESR is enabled, and to nothing otherwise -- so non-ESR images keep exactly
# the layer content (and MRENCLAVE) they had before ESR existed. The securelock
# gates all ESR behaviour on this variable being non-empty.
__ESR_ENV__

RUN mkdir /binary-fs-dir

COPY --from=deps /etny-securelock /etny-securelock/
COPY scripts/* /etny-securelock/

WORKDIR /

RUN ["chmod", "+x", "etny-securelock/binary-fs-build.sh"]
RUN etny-securelock/binary-fs-build.sh

FROM registry.ethernity.cloud:443/debuggingdelight/ethernity-cloud-sdk-registry/sconecuratedimages/crosscompilers:alpine-scone6.0.7 as build

COPY --from=release /binary-fs-dir /.

RUN scone gcc ./binary_fs_blob.s ./libbinary_fs_template.a -shared -o /libbinary-fs.so

FROM ${SCONE_NODE}

COPY --from=build /libbinary-fs.so /lib/libbinary-fs.so

RUN openssl genrsa -3 -out /enclave-key.pem 3072

# SCONE runtime env. These MUST match the enclave-creation params passed to
# scone-signer below (SCONE embeds defaults for anything not signed explicitly;
# any drift makes SCONE recompute + debug re-sign the enclave at load, which CAS
# rejects on mainnet). Values mirror the publish/run docker-compose securelock
# service (SCONE_HEAP=1024M, SCONE_STACK=4M, dlopen=1, extensions=libbinary-fs).
ENV SCONE_HEAP=1024M
ENV SCONE_STACK=4M
ENV SCONE_ALLOW_DLOPEN=1
ENV SCONE_EXTENSIONS_PATH=/lib/libbinary-fs.so
ENV SCONE_LOG=DEBUG

# Rendered by build.mjs. Signs the EXECUTED binary (/usr/local/bin/node -- the
# ENTRYPOINT and the run/publish compose command both run /usr/local/bin/node).
# A CAS-provisioned securelock (mainnet, or a testnet with a SessionRegistry) is
# signed --production; a self-signing testnet one is signed debug.
__SCONE_SIGN__

# Record the SIGNED MRENCLAVE so publish (run.js) can assert, for a
# CAS-provisioned securelock, that the runtime enclave measurement matches what
# was signed BEFORE registering the CAS session. A mismatch means SCONE
# recomputed the enclave at load (params drift) => debug re-sign => the CAS
# rejects it. Capture to a file first: piping scone-signer into `head` kills it
# with SIGPIPE (exit 141) under buildkit's pipefail shell.
__SIGNED_MRENCLAVE__

RUN rm -rf /enclave-key.pem

ENTRYPOINT ["/usr/local/bin/node", "/etny-securelock/securelock.js"]
