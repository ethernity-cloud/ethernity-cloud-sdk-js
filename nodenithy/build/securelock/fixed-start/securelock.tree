# The paths the securelock's fixed start checks (fixed_start.c,
# tree_digest.sh): the directories from which node, started with the fixed
# vector and environment of securelock.h, loads code.
#
# The entry, the modules it requires, its node_modules, the addon and the
# dApp's backend.
/etny-securelock
# The node_modules directory of the entry directory's parent, which Node's
# resolution searches after those of the entry's own directories.
/node_modules
# Node's global folder, $PREFIX/lib/node with PREFIX the directory above
# /usr/local/bin. HOME is not set, so $HOME/.node_modules and
# $HOME/.node_libraries are not searched.
/usr/local/lib/node
