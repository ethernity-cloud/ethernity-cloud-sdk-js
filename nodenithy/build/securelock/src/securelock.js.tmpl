// Force stdout/stderr to be synchronous (blocking). Under SCONE 6 + Node, when
// the process exits quickly (e.g. the PUBLIC_KEY cert-harvest run, which prints
// the cert then returns) Node's pipe-buffered stdout can be torn down before it
// flushes, so the harvested "PUBLIC_KEY:" line is lost and the CI cannot read
// the certificate. Setting the fd handles to blocking makes every console.log
// write synchronously.
try { if (process.stdout._handle && process.stdout._handle.setBlocking) process.stdout._handle.setBlocking(true); } catch (e) {}
try { if (process.stderr._handle && process.stderr._handle.setBlocking) process.stderr._handle.setBlocking(true); } catch (e) {}

