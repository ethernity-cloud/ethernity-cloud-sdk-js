// Baked per network by CI (render_network.sh): "mainnet" | "testnet". On testnet
// the enclave self-signs its cert from MR_ENCLAVE (non-CAS mode); on mainnet the
// cert/key are provisioned by CAS into the injection paths.
const NETWORK_TYPE = "__ETNY_NETWORK_TYPE__";

class EtnySecureLock {
    static debug = false;

    constructor(swiftStreamClient) {
        console.log('Initializing...');
        this.version = 'v3';
        this.swiftStreamService = swiftStreamClient;
        this.etny_bucket = "__ETNY_BUCKET__";
        this.setInitializers();
    }

    setInitializers() {
        this.is_valid_client_data = true;
        // Testnet holds the self-derived identity key HERE, in memory only, and
        // never writes it. Stays null on mainnet, where CAS injects the key into
        // key_file and every consumer reads that path exactly as before.
        this.identity_private_key_pem = null;
        this.key_file = "/private/__ENCLAVE_NAME_SECURELOCK__/key.pem";
        this.cert_file = "/app/__ENCLAVE_NAME_SECURELOCK__/cert.pem";
        this.pub_cert_file = "/app/__ENCLAVE_NAME_SECURELOCK__/enclave_pub_cert.pem";
        this.payload = "payload.etny.securelock";
        this.input = "input.txt.securelock";
        this.result_file = "/app/result.txt";
        this.transaction_file = "/app/transaction.txt";
        this.smart_contract_address = "__ETNY_SMART_CONTRACT_ADDRESS__";
        this.image_registry_address = '__ETNY_IMAGE_REGISTRY_ADDRESS__';
        // ethernity-cas ValidatorRegistry, substituted at BUILD (never CAS- or
        // session-supplied: a rogue CAS must not choose the registry that
        // judges it). Empty = skip CAS self-attestation.
        this.validator_registry_address = '__ETNY_VALIDATOR_REGISTRY_ADDRESS__';
        this.chain_id = __ETNY_CHAIN_ID__;
        this.web3_provider = "__ETNY_WEB3_PROVIDER__";
        this.signed_tx_as_bytes = null;
        this.client_challenge = "";

        if (this.etny_mode === "TEST") {
            this.key_file = "/private/key.pem";
            this.cert_file = "/app/cert.pem";
            this.payload = "./app/payload.js";
            this.input = "./app/input.txt";
            this.result_file = "./app/result.txt";
            this.transaction_file = "./app/transaction.txt";
            this.pub_cert_file = "./app/enclave_pub_cert.pem";
        }

        if (this.etny_mode === "LOCAL_TEST") {
            this.key_file = "./certs/key.pem";
            this.cert_file = "./certs/cert.pem";
            this.payload = "./app/payload.js";
            this.input = "./app/input.txt";
            this.result_file = "./app/result.txt";
            this.transaction_file = "./app/transaction.txt";
            this.pub_cert_file = "./app/enclave_pub_cert.pem";
        }
    }

    async create() {
        //overriding default values with those read from .env file
        this.loadEnv();
        this.printEnv();
        await this.savePublicCert();
        this.initWeb3();
        await this.verifyCasAttestation();
        if (this.etny_mode === "PRODUCTION") {
            this.resetPrivateCertFile();
        }

        return true;
    }

    /**
     * Endpoints for a CAS, read FROM CHAIN -- never from the environment.
     *
     * The node operator controls the host and everything the enclave is
     * handed, so the address we dial must come from the ValidatorRegistry
     * itself. ENS names are tried first, then literal multiaddrs, /onion3
     * preferred (matching the node-side resolver). Returns REST base URLs.
     */
    async casEndpointsFromChain(casAddress) {
        // Endpoints live in the CasKeyStore the registry names via keyStore();
        // the registry's own forwarders were removed when it reached the
        // EIP-170 size limit.
        const registryAbi = ['function keyStore() view returns (address)'];
        const storeAbi = ['function multiaddrsOf(address) view returns (string[])'];
        let mas;
        try {
            const vr = new ethers.Contract(this.validator_registry_address, registryAbi, this.w3);
            const store = new ethers.Contract(await vr.keyStore(), storeAbi, this.w3);
            mas = await store.multiaddrsOf(casAddress);
        } catch (e) {
            console.warn(`CAS attestation: reading the CAS endpoints from chain failed: ${e.message || e}`);
            return [];
        }
        const onion = [], rest = [];
        for (const ma of mas) {
            const parts = String(ma).split('/').filter((p) => p);
            if (parts.length !== 4 || parts[2] !== 'tcp') continue;
            const kind = parts[0];
            let host = parts[1];
            const port = parseInt(parts[3], 10);
            if (!Number.isInteger(port)) continue;
            // REST pairing convention: a CAS publishes its enclave port only,
            // and its REST port sits at the same offset from the in-container
            // pair 18765/8081 (19768 -> 9084).
            const restPort = 8081 + (port - 18765);
            if (restPort < 1 || restPort > 65535) continue;
            if (kind === 'onion3') {
                if (!host.endsWith('.onion')) host += '.onion';
                onion.push(`http://${host}:${restPort}`);
            } else if (['dns4', 'dns6', 'dns', 'ip4', 'ip6'].includes(kind)) {
                rest.push(`http://${host}:${restPort}`);
            }
        }
        return onion.concat(rest);
    }

    /**
     * ENCLAVE-INITIATED CAS attestation: prove the CAS is live NOW.
     *
     * The CAS runs on a separate, remote system, so the operator sits on the
     * network path. Stock SCONE offers the enclave no way to challenge the
     * CAS, so we run the challenge on our own channel:
     *
     *   - the CAS injected ECAS_ATTEST_SESSION, a RANDOM 128-hex session id it
     *     minted for THIS enclave and holds OPEN;
     *   - we resolve its endpoint FROM CHAIN (so the operator cannot redirect
     *     us), present that id with a nonce WE choose, and the CAS returns a
     *     FRESH DCAP quote whose report_data binds
     *     sha256(session || nonce || casAddr || certHash);
     *   - we recompute that commitment and compare, and re-check the quote's
     *     MRENCLAVE against the registry.
     *
     * A captured environment is useless once its session closes (the CAS
     * refuses to mint), and a captured RESPONSE is useless because our nonce
     * differs every time. Resolves to null on success, else a failure reason.
     */
    async challengeCas(casAddress, registeredMrenclave, registeredCert) {
        const sessionId = process.env.ECAS_ATTEST_SESSION || '';
        if (!sessionId) {
            return 'no ECAS_ATTEST_SESSION in the environment (CAS cannot be challenged)';
        }
        const nonce = crypto.randomBytes(32);
        // Echo back the nonce the CAS injected, so the SAME fresh quote also
        // re-attests the environment we were handed (report_data[52:64]). The
        // CAS recomputes the injected commitment from its own address and cert
        // -- we supply only the nonce -- so this cannot be steered.
        const envNonceHex = process.env.ECAS_ENCLAVE_NONCE || '';
        const payload = JSON.stringify({session: sessionId, nonce: nonce.toString('hex'),
                                        env_nonce: envNonceHex});

        const endpoints = await this.casEndpointsFromChain(casAddress);
        if (!endpoints.length) {
            return 'the CAS publishes no dialable endpoint on chain';
        }
        let last = 'no endpoint answered';
        for (const base of endpoints) {
            const url = `${base}/attest/session`;
            let doc;
            try {
                doc = await this.postJson(url, payload, 20000);
            } catch (e) {
                last = `${url}: ${e.message || e}`;
                continue;
            }
            const quote = Buffer.from(String(doc.quote || ''), 'hex');
            if (quote.length < 48 + 384) {
                return `${url}: challenge quote too short (${quote.length} bytes)`;
            }
            const rd = quote.slice(368, 432);
            const gotAddr = '0x' + rd.slice(32, 52).toString('hex');
            if (gotAddr.toLowerCase() !== casAddress.toLowerCase()) {
                return `challenge quote names ${gotAddr}, not the CAS ${casAddress} we verified on chain`;
            }
            const expect = crypto.createHash('sha256')
                .update(Buffer.from(sessionId, 'utf8'))
                .update(nonce)
                .update(Buffer.from(casAddress.replace(/^0x/, ''), 'hex'))
                .update(Buffer.from(registeredCert, 'hex'))
                .digest();
            if (!expect.equals(rd.slice(0, 32))) {
                return 'challenge commitment mismatch: the CAS did not sign our ' +
                       'session+nonce (stale or replayed response)';
            }
            // ENVIRONMENT RE-ATTESTATION. When we sent env_nonce, the fresh
            // quote must also carry the head of the commitment that went into
            // ECAS_CAS_QUOTE. This is what ties the two quotes together: a live
            // CAS confirming, under a NEW signature, that the environment we
            // hold is the one it sent. Without it the challenge proved only
            // that some CAS was alive.
            if (envNonceHex) {
                const envExpect = crypto.createHash('sha256')
                    .update(Buffer.from(sessionId, 'utf8'))
                    .update(Buffer.from(envNonceHex, 'hex'))
                    .update(Buffer.from(casAddress.replace(/^0x/, ''), 'hex'))
                    .update(Buffer.from(registeredCert, 'hex'))
                    .digest();
                if (!rd.slice(52, 64).equals(envExpect.slice(0, 12))) {
                    return 'the CAS did not confirm the environment it sent: ' +
                           `fresh quote carries ${rd.slice(52, 64).toString('hex')}, ` +
                           `expected ${envExpect.slice(0, 12).toString('hex')}`;
                }
                console.log('CAS re-attested the injected environment under a fresh signature');
            }
            const qmr = quote.slice(112, 144).toString('hex');
            if (qmr.toLowerCase() !== registeredMrenclave.toLowerCase()) {
                return `challenge quote MRENCLAVE ${qmr} != registered ${registeredMrenclave}`;
            }
            console.log(`CAS CHALLENGE PASSED: ${base} signed our session+nonce with a ` +
                        `fresh quote (MRENCLAVE ${qmr.slice(0, 16)}...)`);
            return null;
        }
        return `CAS challenge failed: ${last}`;
    }

    /** Minimal JSON POST over plain http -- the CAS REST port is http. */
    postJson(url, body, timeoutMs) {
        return new Promise((resolve, reject) => {
            const http = require('http');
            const u = new URL(url);
            const req = http.request({
                hostname: u.hostname,
                port: u.port || 80,
                path: u.pathname,
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Content-Length': Buffer.byteLength(body),
                },
                timeout: timeoutMs,
            }, (res) => {
                const chunks = [];
                res.on('data', (c) => chunks.push(c));
                res.on('end', () => {
                    const text = Buffer.concat(chunks).toString('utf8');
                    try {
                        resolve(JSON.parse(text));
                    } catch (e) {
                        reject(new Error(`HTTP ${res.statusCode}: ${text.slice(0, 200)}`));
                    }
                });
            });
            req.on('timeout', () => req.destroy(new Error('timeout')));
            req.on('error', reject);
            req.write(body);
            req.end();
        });
    }

    /**
     * Verify the CAS that provisioned this enclave. The CAS injects
     * ECAS_CAS_QUOTE, a DCAP quote of itself, in one of two report_data
     * layouts (fresh: commitment at [0:32], address at [32:52]; legacy:
     * address at [0:20], cert hash at [20:52]). We check it against the
     * ValidatorRegistry baked into this build: active validator, registered
     * MRENCLAVE match, registered certHash match. Evicting a CAS on-chain
     * revokes it here on the next task. STRICT: a missing quote, an invalid
     * one, and an unreachable registry (after retries) are all the same
     * terminal fault (refund); there is no softening knob -- the session env
     * comes from the CAS itself. The quote's ECDSA/PCK chain is not verified
     * in-enclave yet; the binding is quote-contents <-> on-chain record (the
     * revocation path).
     */
    async verifyCasAttestation() {
        const registry = this.validator_registry_address;
        this.cas_attestation_fault = null;
        const fault = (reason) => {
            // TERMINAL. A network that carries a ValidatorRegistry EXPECTS an
            // attested CAS, so a MISSING quote is as damning as a wrong one --
            // the operator provisioned this task outside the validator set.
            // Recorded here and adjudicated before the payload
            // is handled -- the task then terminates with
            // CAS_ATTESTATION_FAULT (40) and the order is refunded.
            console.error(`CAS ATTESTATION INVALID: ${reason}`);
            this.cas_attestation_fault = reason;
        };

        if (!registry || registry.startsWith('__')) {
            console.log('CAS attestation: no ValidatorRegistry for this network; skipping');
            return;
        }
        const quoteB64 = process.env.ECAS_CAS_QUOTE || '';
        if (!quoteB64) {
            return fault('no ECAS_CAS_QUOTE in the session environment (unattested CAS)');
        }
        const quote = Buffer.from(quoteB64, 'base64');
        // DCAP quote layout: 48-byte header; report body: ATTRIBUTES at
        // body+48 (16), MRENCLAVE at body+64 (32), report_data at body+320 (64).
        if (quote.length < 48 + 384) {
            return fault(`quote too short (${quote.length} bytes)`);
        }
        const attributes = quote.slice(96, 112);
        const quoteMrenclave = quote.slice(112, 144).toString('hex');
        const reportData = quote.slice(368, 432);
        // TWO report_data layouts, distinguished by which one names a
        // REGISTERED validator (checked below):
        //   fresh  (per-session): [0:32] freshness commitment, [32:52] address
        //   legacy (boot quote):  [0:20] address,              [20:52] cert hash
        // The fresh layout is what a current CAS injects; legacy remains only
        // for a CAS that could not read this enclave's nonce. Reading the wrong
        // one would parse commitment bytes as an address and fail every task,
        // so both are resolved and the registry decides which is real.
        const casCandidates = [
            [ethers.utils.getAddress('0x' + reportData.slice(32, 52).toString('hex')), null],
            [ethers.utils.getAddress('0x' + reportData.slice(0, 20).toString('hex')),
             reportData.slice(20, 52).toString('hex')],
        ];

        const vrAbi = [
            'function isValidator(address) view returns (bool)',
            // The registry's Validator struct: the measurement is `bytes` at
            // its platform width (32 for SGX MRENCLAVE), not bytes32.
            'function validators(address) view returns (bytes measurement, bytes32 certHash, bool active, uint64 admittedBlock, uint64 lastVoteBlock, uint16 teeType, address operator)',
        ];
        let active = false, record = null, lastErr = null;
        let casAddress = null, boundCert = null;
        for (let attempt = 0; attempt < 3; attempt++) {
            try {
                const vr = new ethers.Contract(registry, vrAbi, this.w3);
                // Whichever layout names an ACTIVE validator is the real one.
                for (const [candAddr, candCert] of casCandidates) {
                    if (await vr.isValidator(candAddr)) {
                        casAddress = candAddr;
                        boundCert = candCert;
                        active = true;
                        record = await vr.validators(candAddr);
                        break;
                    }
                }
                if (!active) {
                    // Both layouts resolved to non-validators: report the
                    // fresh-layout address, which is what a current CAS sends.
                    [casAddress, boundCert] = casCandidates[0];
                }
                lastErr = null;
                break;
            } catch (e) {
                lastErr = e;
                await new Promise((r) => setTimeout(r, 5000));
            }
        }
        if (lastErr !== null) {
            // The enclave already depends on this chain for its order
            // metadata, so an unreachable registry is not a new fragility --
            // and treating it softly would let an operator bypass the check
            // by firewalling the RPC.
            return fault(`ValidatorRegistry ${registry} unreachable after 3 attempts: ${lastErr.message || lastErr}`);
        }
        if (!active) {
            return fault(`CAS ${casAddress} is NOT an active validator`);
        }
        const registeredMr = record.measurement.replace(/^0x/, '');
        if (registeredMr !== quoteMrenclave) {
            return fault(`CAS quote MRENCLAVE ${quoteMrenclave} != registered ${registeredMr}`);
        }
        const registeredCert = record.certHash.replace(/^0x/, '');
        if (boundCert !== null) {
            // Legacy layout: the cert hash is a readable field, compare it.
            if (registeredCert !== '0'.repeat(64) && registeredCert !== boundCert) {
                return fault(`CAS quote cert hash ${boundCert} != registered ${registeredCert}`);
            }
        } else {
            // FRESH layout: the cert hash is not a readable field -- it is
            // folded into report_data[0:32] together with the attestation
            // SESSION ID and this enclave's own nonce. Recomputing that
            // commitment is what binds the injected ENVIRONMENT AS ONE UNIT:
            // ECAS_ATTEST_SESSION, ECAS_ENCLAVE_NONCE and ECAS_CAS_QUOTE only
            // agree if the CAS minted all three together for THIS session. An
            // operator who strips the session id, swaps in another enclave's
            // id, or pairs a captured quote with a fresh session breaks the
            // hash -- and cannot repair it, because the commitment is inside
            // an SGX signature.
            //
            // The nonce is echoed by the CAS because SCONE gives the enclave
            // no way to read its own attestation report_data. Echoing costs
            // nothing: a tampered nonce simply fails to reproduce [0:32].
            if (registeredCert === '0'.repeat(64)) {
                // Without a registered cert there is nothing to recompute
                // against, so the binding cannot be proven. Tolerating that
                // would hand every CAS an opt-out: leave certHash unset and
                // the strongest check silently disappears.
                return fault(`CAS ${casAddress} has no certHash registered; ` +
                             'the fresh quote binding cannot be verified');
            }
            const sessionId = process.env.ECAS_ATTEST_SESSION || '';
            const nonceHex = process.env.ECAS_ENCLAVE_NONCE || '';
            if (!sessionId) {
                return fault('fresh CAS quote but no ECAS_ATTEST_SESSION ' +
                             '(environment was tampered with)');
            }
            if (!nonceHex) {
                return fault('fresh CAS quote but no ECAS_ENCLAVE_NONCE ' +
                             '(environment was tampered with)');
            }
            if (!/^[0-9a-fA-F]*$/.test(nonceHex) || nonceHex.length % 2 !== 0) {
                return fault('ECAS_ENCLAVE_NONCE is not hex');
            }
            const expected = crypto.createHash('sha256')
                .update(Buffer.from(sessionId, 'utf8'))
                .update(Buffer.from(nonceHex, 'hex'))
                .update(Buffer.from(casAddress.replace(/^0x/, ''), 'hex'))
                .update(Buffer.from(registeredCert, 'hex'))
                .digest();
            if (!expected.equals(reportData.slice(0, 32))) {
                return fault('CAS quote does not commit to the injected environment ' +
                             `(session ${sessionId.slice(0, 16)}..., expected ` +
                             `${expected.toString('hex').slice(0, 16)}..., quote carries ` +
                             `${reportData.slice(0, 32).toString('hex').slice(0, 16)}...)`);
            }
            console.log('CAS environment binding OK: quote commits to ' +
                        `attestation session ${sessionId.slice(0, 16)}...`);
        }
        // SGX ATTRIBUTES.FLAGS bit 1 = DEBUG. A debug CAS protects nothing: its
        // memory is readable from outside the enclave, so its keys and the
        // session it serves are not secret. Both CAS modes (mainnet and
        // testnet_cas) REFUSE one. Only plain 'testnet' tolerates it, and there
        // the enclave never contacts a CAS at all so the check never runs.
        if ((attributes[0] & 0x02) && NETWORK_TYPE !== 'testnet') {
            return fault('CAS enclave runs in SGX DEBUG mode');
        }
        console.log(`CAS ATTESTATION VERIFIED: validator ${casAddress}, ` +
                    `MRENCLAVE ${quoteMrenclave.slice(0, 16)}..., certificate bound on-chain`);

        // LIVENESS. Everything above proves the injected quote matches an
        // on-chain record -- but the environment was handed to us by the node.
        // Challenge the CAS ourselves over an endpoint resolved FROM CHAIN,
        // with a nonce we pick, so nothing replayed can pass. Same terminal
        // fault (refund) as any other CAS-attestation failure.
        const challengeError = await this.challengeCas(
            casAddress, registeredMr, registeredCert);
        if (challengeError !== null) {
            return fault(challengeError);
        }
    }

    loadEnv() {
        // The chain id, PoX smart contract, Image Registry, Web3 provider and
        // the SwiftStream bucket are build constants (setInitializers), never
        // read from process.env: the node supplies the environment, and an
        // override would let it choose the registry the trustedzone's
        // certificate comes from. Only the per-task values below are taken
        // from the environment.
        if (process.env.ETNY_CLIENT_CHALLENGE) {
            this.client_challenge = process.env.ETNY_CLIENT_CHALLENGE.trim();
        }
        if (process.env.ETNY_ORDER_ID) {
            this.order_id = parseInt(process.env.ETNY_ORDER_ID);
        }
    }

    printEnv() {
        console.log('CHAIN ID:', this.chain_id);
        console.log('SMART CONTRACT ADDRESS:', this.smart_contract_address);
        console.log('WEB3 PROVIDER:', this.web3_provider);
        console.log('ENCRYPTED CHALLENGE:', this.client_challenge);
        console.log('ORDER ID:', this.order_id);
    }

    initWeb3() {
        // Create an ethers.js provider connected to the Bloxberg network
        this.w3 = new ethers.providers.JsonRpcProvider(this.web3_provider);
        // Create an instance of the contract using the ABI and address
        this.etny = new ethers.Contract(this.smart_contract_address, contract_abi, this.w3);
        this.image_registry = new ethers.Contract(this.image_registry_address, image_registry_abi, this.w3);
        // this.iamge_registry_signer = new ethers.Contract(this.image_registry_address, image_registry_abi.abi, this.walletSigner);
    }

    // The node-supplied bucket .env may only contribute these per-task values.
    // Everything else the securelock trusts is a build constant (chain id, PoX
    // contract, Image Registry, Web3 provider, ValidatorRegistry, bucket) or a
    // variable the CAS injects into the enclave process environment (ECAS_*,
    // SCONE_*). Any key outside this set, and any key already present in
    // process.env, is ignored.
    static NODE_ENV_ALLOWLIST = new Set([
        'ETNY_MODE',
        'ETNY_ORDER_ID',
        'ETNY_CLIENT_CHALLENGE',
    ]);

    async readEnv() {
        try {
            console.log('Getting .env if exists...');
            const envFile = await this.swiftStreamService.getFileContent(this.etny_bucket, ".env");
            console.log("Env:", envFile);
            // Parsed in memory: dotenv.parse does not touch process.env.
            const parsed = require('dotenv').parse(Buffer.from(envFile));
            for (const [key, value] of Object.entries(parsed)) {
                if (!EtnySecureLock.NODE_ENV_ALLOWLIST.has(key)) {
                    console.log(`Ignoring non-allowlisted .env key from the node bucket: ${key}`);
                    continue;
                }
                if (Object.prototype.hasOwnProperty.call(process.env, key)) {
                    continue;
                }
                process.env[key] = value;
            }

            this.version = 'v3';
            this.etny_mode = process.env.ETNY_MODE;
            console.log(`ETNY Nodenithy [${this.version}] - running in ${this.etny_mode} MODE`);
            //console.log(process.env);

            return true;
        } catch (e) {
            return false;
        }
    }

    // The order metadata, from the chain, retried over transient RPC failures.
    // It names the trustedzone whose certificate checks the handover and
    // encrypts the result, so without it no result reaches the trustedzone.
    // Returns whether it was loaded; a persistent failure sets SYSTEM_ERROR.
    async loadOrderMetadata() {
        const maxRetries = 5;
        for (let attempt = 1; ; attempt++) {
            try {
                await this.getDORequestMetadata();
                return true;
            } catch (e) {
                if (attempt === maxRetries) {
                    this.task_code = TaskStatus.SYSTEM_ERROR;
                    this.task_result = `Failed to fetch metadata after ${maxRetries} attempts: ${e && e.message ? e.message : e}`;
                    this.is_valid_client_data = false;
                    return false;
                }
            }
        }
    }

    // v4 checksum validation: the DO-request is submitted on-chain by the owner,
    // so the metadata checksum is already authenticated by the transaction sender;
    // we only confirm the file content hashes to that recorded checksum. An
    // empty input (no CID) is checked against its recorded checksum when there
    // is one (the runners record the checksum of the empty string) and is the
    // empty string when there is none; an input that names a CID must carry a
    // checksum. Data that could not be read or decrypted (false) is reported,
    // not hashed. Kept identical across securelock / trustedzone / validator so
    // all three agree.
    async validateClientPayload(payload_data, input_data) {
        if (typeof payload_data !== 'string') {
            this.task_code = TaskStatus.PAYLOAD_CHECKSUM_ERROR;
            this.task_result = 'PAYLOAD NOT AVAILABLE';
            this.is_valid_client_data = false;
            return;
        }
        if (typeof input_data !== 'string') {
            this.task_code = TaskStatus.INPUT_CHECKSUM_ERROR;
            this.task_result = 'INPUT NOT AVAILABLE';
            this.is_valid_client_data = false;
            return;
        }
        const pmeta = this._metadata.payload_metadata_obj;
        if (pmeta.has_checksum) {
            const expected = pmeta.checksum.toLowerCase().replace(/^0x/, '');
            if (sha256(payload_data) !== expected) {
                this.task_code = TaskStatus.PAYLOAD_CHECKSUM_ERROR;
                this.task_result = 'PAYLOAD CHECKSUM DOESN\'T MATCH';
                this.is_valid_client_data = false;
                return;
            }
        } else {
            // payload is required and must carry a checksum
            this.task_code = TaskStatus.PAYLOAD_CHECKSUM_ERROR;
            this.task_result = 'PAYLOAD CHECKSUM DOESN\'T EXIST';
            this.is_valid_client_data = false;
            return;
        }

        const imeta = this._metadata.input_metadata_obj;
        if (imeta.has_checksum) {
            const expected = imeta.checksum.toLowerCase().replace(/^0x/, '');
            if (sha256(input_data) !== expected) {
                this.task_code = TaskStatus.INPUT_CHECKSUM_ERROR;
                this.task_result = 'INPUT CHECKSUM DOESN\'T MATCH';
                this.is_valid_client_data = false;
            }
        } else if (imeta.ipfs_hash) {
            this.task_code = TaskStatus.INPUT_CHECKSUM_ERROR;
            this.task_result = 'INPUT CHECKSUM DOESN\'T EXIST';
            this.is_valid_client_data = false;
        } else if (input_data !== '') {
            this.task_code = TaskStatus.INPUT_CHECKSUM_ERROR;
            this.task_result = 'INPUT CHECKSUM DOESN\'T MATCH';
            this.is_valid_client_data = false;
        }
    }

    wait(timeout) {
        return new Promise(resolve => {
            setTimeout(resolve, timeout);
        });
    }

    async waitForObjectInBucket(bucketName, objectName, timeout = 600) {
        let i = 0;
        console.log(`Checking if object ${objectName} exists in bucket ${bucketName}`);
        while (true) {
            await this.wait(1000);
            i++;
            if (i % 20 === 0)
                console.log(`Checking if object ${objectName} exists in bucket ${bucketName}`);
            if (i > timeout) {
                break;
            }
            const [status, result] = await this.swiftStreamService.isObjectInBucket(bucketName, objectName);
            if (result) {
                break;
            }
        }

        console.log('TrustedZone finished the execution');
    }

    async waitForPayloadAndInput() {
        console.log('Waiting for payload and input');
        await this.waitForObjectInBucket(this.etny_bucket, this.payload);
        await this.waitForObjectInBucket(this.etny_bucket, this.input);
    }

    async getFileContentAndDecrypt(bucketName, objectName) {
        try {
            const encryptedBase64 = await this.swiftStreamService.getFileContent(bucketName, objectName);

            const encryptedTuple = etny_crypto.encryptedDataFromBase64Json(encryptedBase64);
            const decryptedResult = etny_crypto.decrypt(this.privateKeyMaterial(), encryptedTuple);
            // decrypt() returns false for an object that does not decrypt.
            return decryptedResult === false ? false : decryptedResult.toString();
        } catch (e) {
            console.log(`Failed to get ${objectName} file`);
            return false;
        }
    }

    async getTrustedZonePublicKey() {
        try {
            // The certificate of the trustedzone the order runs with: the latest
            // v3 image registered under the trustedzone name in metadata1 field 2,
            // as the Python securelock reads it. Field 1 is this securelock's own
            // hash, which is not a trustedzone entry.
            console.log('Getting the public key of the trusted zone enclave');
            const trustedZoneName = this._metadata.image_metadata.split(':')[2];
            console.log('trustedZoneName:', trustedZoneName);
            const latest = await this.image_registry.getLatestTrustedZoneImageCertPublicKey(trustedZoneName, 'v3');
            this.trustedZonePublicKey = latest[1];
            console.log('Public key of the TrustedZone enclave from smart contract:', this.trustedZonePublicKey);
        } catch (e) {
            console.log('getTrustedZonePublicKey', e);
        }
    }

    async encryptFileAndPushToSwiftStream(fileData, fileName) {
        try {
            console.log(`Started saving file ${fileName}.securelock...`);
            const encryptedInput = etny_crypto.encrypt(this.trustedZonePublicKey, fileData);
            const encryptedInputBase64 = etny_crypto.encryptedDataToBase64Json(encryptedInput);

            // File name should end with the '.securelock' extension
            fileName += '.securelock';
            // const data = Buffer.from(encryptedInputBase64, 'utf8');
            const status = this.swiftStreamService.putFileContent(this.etny_bucket, fileName, '', encryptedInputBase64);
            if (status) {
                console.log(`File ${fileName} encrypted and saved to swift stream successfully`);
            }
        } catch (e) {
            console.log('encryptFileAndPushToSwiftStream', e);
        }
    }

    async getDORequestMetadata() {
        const o_result = await this.etny.functions._getOrder(this.order_id);
        const order = new Order(o_result, this.order_id);
        //console.log('order', order);
        this._order_metadata = order;
        const o_metadata = await this.etny.functions._getDORequestMetadata(order.do_req);
        this._metadata = new DOReqMetadata(o_metadata, order.do_req);
        //console.log('metadata', this._metadata);
    }

    resetPrivateCertFile() {
        // Wipes the CAS-injected key from disk after it has been loaded
        // (mainnet PRODUCTION hygiene). On testnet the key was never written --
        // it lives only in memory -- so there is nothing on disk to wipe and the
        // truncate/read below would throw on a file that does not exist.
        //
        // The in-memory key is deliberately NOT cleared here: waitForPayloadAndInput
        // still needs it later to decrypt the payload/input, which runs after
        // create() has called this. Clearing it would break the task on testnet only.
        if (this.identity_private_key_pem) {
            return;
        }
        try {
            fs.truncate(this.key_file, 0, function () {
                //console.log('Private certificate file was cleaned.')
            });
        } catch (e) {
            //console.log('Error while removing the private key file content', e);
        }
        try {
            fs.readFileSync(this.key_file, 'utf8');
        } catch (e) {
            // Nothing to read back; the wipe above is what mattered.
        }
    }

    // Testnet non-CAS mode: derive a deterministic self-signed cert/key from this
    // enclave's identity. The CERTIFICATE is written (it is public, and
    // savePublicCert reads it back to publish it); the PRIVATE KEY is kept ONLY
    // in memory and never touches the filesystem.
    //
    // Why memory-only: on testnet there is no CAS and no attestation, so nothing
    // provisions or protects the key from outside the enclave. Not writing it at
    // all removes every at-rest attack on it outright, instead of relying on the
    // file protection being keyed by something trustworthy on this path.
    //
    // MAINNET IS UNCHANGED: this method returns immediately there, CAS still
    // injects cert+key into key_file/cert_file, and every consumer still reads
    // key_file exactly as before (this.identity_private_key_pem stays null, and
    // privateKeyMaterial() falls back to the path).
    //
    // Idempotent: the key is a pure function of the enclave identity, so it is
    // identical across restarts without needing to persist it.
    generateSelfSignedCertIfTestnet() {
        // A testnet build with a ValidatorRegistry baked in is CAS-provisioned
        // (ethernity-cas): its key and cert are injected into key_file and
        // cert_file by the CAS session, exactly as on mainnet, and the same
        // registry is what verifyCasAttestation checks the CAS against.
        if (NETWORK_TYPE !== "testnet" || this.casProvisioned()) return;
        console.log("[SecureLock] TESTNET: self-signing certificate from MR_ENCLAVE (no CAS) [TESTNET-INSECURE]");
        const {privateKeyPem, certPem, mrEnclaveHex} = generateCertFromMrEnclave("SecureLock Enclave");
        console.log(`[SecureLock] MR_ENCLAVE: ${mrEnclaveHex}`);
        for (const f of [this.cert_file, this.pub_cert_file]) {
            try { fs.mkdirSync(require('path').dirname(f), {recursive: true}); } catch (e) {}
        }
        // Private key: memory only. Deliberately NOT written to this.key_file.
        this.identity_private_key_pem = privateKeyPem;
        fs.writeFileSync(this.cert_file, certPem);
    }

    // Whether this build's certificate comes from a CAS session: mainnet, or a
    // testnet with a ValidatorRegistry baked in.
    casProvisioned() {
        const registry = String(this.validator_registry_address || '');
        return NETWORK_TYPE === "mainnet" || (registry !== '' && !registry.startsWith('__'));
    }

    // The enclave's identity private key, in whatever form this network provides
    // it: the in-memory PEM on a self-signing testnet, or the CAS-injected
    // key_file path otherwise. etny_crypto accepts either, so callers do not
    // branch on network.
    privateKeyMaterial() {
        return this.identity_private_key_pem || this.key_file;
    }

    async savePublicCert() {
        try {
            const content = await fs.promises.readFile(this.cert_file, 'utf8');
            await fs.promises.writeFile(this.pub_cert_file, content);
            //console.log(`Public certificate saved to ${this.pub_cert_file}`);
            console.log(`PUBLIC_KEY:`);
            console.log(content);

            // ESR (RFC §5.2): emit the enclave's ESR wallet ADDRESS on the same
            // harvest channel as the cert, so publish (or the remote extraction
            // service) can capture it. It MUST be derived here rather than by the
            // service: on mainnet the identity key is CAS-provisioned and exists
            // only inside this enclave, so nobody outside can compute the address.
            // Only the address is emitted — the private key never leaves.
            this.emitEsrWalletAddress();

            await this.swiftStreamService.putFileContent(this.etny_bucket, 'cert.pem', this.pub_cert_file);
        } catch (err) {
            console.error(err);
        }
    }

    // ESR wallet address emission (RFC §5.2). Gated on ESR_CONTRACT_ADDRESS being
    // set, exactly like the Python securelock, so non-ESR images print nothing.
    // Derived from the enclave's own identity private key (the certificate key);
    // only the ADDRESS is logged, never the key. Any failure is reported as
    // ESR_WALLET_ERROR and never breaks cert harvest or a task.
    emitEsrWalletAddress() {
        if (!String(process.env.ESR_CONTRACT_ADDRESS || "").trim()) return;
        try {
            // The identity key the enclave actually holds: the CAS-provisioned
            // key_file on mainnet (nothing in-enclave can re-derive it), or the
            // in-memory PEM on testnet (never written to disk). Hashed as-is,
            // matching the Python SDK.
            const identityPriv = this.identity_private_key_pem
                || fs.readFileSync(this.key_file, 'utf8');
            const esrAddress = esr_wallet.deriveWalletAddress(identityPriv);
            console.log(`ESR_WALLET_ADDRESS: ${esrAddress}`);
            if (!esr_wallet.isSecretIdentity(NETWORK_TYPE, this.casProvisioned())) {
                console.warn(esr_wallet.INSECURE_IDENTITY_WARNING);
            }
        } catch (e) {
            // Never let ESR derivation break harvest/a task: report it the way
            // every other enclave-side config problem is reported.
            console.error(`ESR_WALLET_ERROR: ${e && e.message ? e.message : e}`);
        }
    }

    async saveResult() {
        try {
            // A failure reported before execute() loaded the order metadata
            // (one thrown in create(), see reportFailure) loads it here.
            if (!this._metadata && !(await this.loadOrderMetadata())) {
                console.log('Save result: no order metadata, so no trustedzone certificate to encrypt the result to');
                return;
            }
            await this.getTrustedZonePublicKey();
            // THE HANDOVER IS ALWAYS SIGNED: the trustedzone refuses an
            // unverifiable result/result-code, so the operator's storage
            // layer between the enclaves can never substitute either value.
            // Signed over the task binding when the trustedzone supplied one
            // ("<challenge>:<order_id>:" ahead of the data), so each signature
            // attests this order and this run's challenge; the data itself is
            // pushed unchanged. Without a binding (older trustedzone) the bare
            // data is signed, which that trustedzone verifies.
            const binding = this.task_binding
                ? `${this.task_binding.challenge}:${this.task_binding.order_id}:` : '';
            await this.encryptFileAndPushToSwiftStream(this.task_result, 'result.txt');
            await this.encryptFileAndPushToSwiftStream(
                etny_crypto.signData(this.privateKeyMaterial(), binding + String(this.task_result)),
                'result.txt.sig');
            await this.encryptFileAndPushToSwiftStream(this.task_code.toString(), 'result_code.txt');
            await this.encryptFileAndPushToSwiftStream(
                etny_crypto.signData(this.privateKeyMaterial(), binding + this.task_code.toString()),
                'result_code.txt.sig');

            const encrypted = etny_crypto.encryptWithPublicKey(this._metadata.public_key, this.task_result);
            //console.log('Encrypted result:', encrypted.toString('hex'));
            const result = await this.swiftStreamService.putFileContent(this.etny_bucket, 'result.txt', this.result_file, encrypted.toString('hex'));
            //console.log('Save result put: ', result);
        } catch (e) {
            console.log('Save result: ', e);
        }
    }

    // Make StateRegistry usable from payload code, if ESR is enabled.
    //
    // Wires ecld_state to this enclave's identity key, the SwiftStream client
    // and bucket the node shares with us, the registry address baked in at build
    // time, and the provider. Payload code then just does:
    //
    //     const {StateRegistry} = require('./ecld_state');
    //     await new StateRegistry().commit('key', s => ...);
    //
    // No-op when ESR is disabled, so non-ESR enclaves are unaffected. Never
    // throws: a setup problem must not stop the task from running -- payload
    // code that then uses StateRegistry gets a clear error from the registry
    // itself rather than a task that died before starting.
    configureStateRegistry() {
        const contractAddress = String(process.env.ESR_CONTRACT_ADDRESS || "").trim();
        if (!contractAddress) return;
        try {
            const ecld_state = require("./ecld_state");
            ecld_state.configure({
                identityPriv: this.identity_private_key_pem || fs.readFileSync(this.key_file, 'utf8'),
                swiftStreamService: this.swiftStreamService,
                bucket: this.etny_bucket,
                contractAddress: contractAddress,
                provider: this.w3,
                caller: this.task_caller || null,
            });
            console.log(`StateRegistry ready (ESR ${contractAddress})`);
        } catch (e) {
            console.error(`ESR_STATE_ERROR: could not configure StateRegistry: ${e && e.message ? e.message : e}`);
        }
    }

    async execute() {
        // The order metadata names the trustedzone whose certificate checks
        // the handover and encrypts the result, and the task binding is signed
        // into the result; both are read before any check that can end the
        // task, so every outcome below reaches the trustedzone as a result it
        // can verify.
        if (!(await this.loadOrderMetadata())) {
            return false;
        }
        await this.getTrustedZonePublicKey();

        // Task binding: the order id and enclave challenge the trustedzone
        // generated for this task, forwarded as task.securelock + .sig. When
        // present (and only with a valid trustedzone signature) the result and
        // the code are signed over "<challenge>:<order_id>:" and the envelope
        // carries both, so the trustedzone can refuse a result captured from
        // any other run. Absent with an older trustedzone, which then verifies
        // the bare result as before.
        this.task_binding = null;
        try {
            const taskValue = await this.getFileContentAndDecrypt(this.etny_bucket, 'task.securelock');
            const taskSig = await this.getFileContentAndDecrypt(this.etny_bucket, 'task.securelock.sig');
            if (etny_crypto.verifySignature(this.trustedZonePublicKey, taskValue, taskSig)) {
                const task = JSON.parse(String(taskValue));
                if (Number.isInteger(Number(task.order_id)) && typeof task.challenge === 'string' && task.challenge) {
                    this.task_binding = { order_id: Number(task.order_id), challenge: task.challenge };
                    console.log(`Task binding attested by trustedzone: order ${this.task_binding.order_id}`);
                }
            } else {
                console.error('task.securelock signature validation FAILED; result will not be bound');
            }
        } catch (e) {
            console.log('No task binding supplied; result will not be bound');
        }

        // ADJUDICATE the CAS attestation verdict recorded at startup. An
        // INVALID CAS quote terminates the task before the payload is
        // handled; the failure result (CAS_ATTESTATION_FAULT, 40) reaches
        // the chain -- the refundable operator-fault path.
        if (this.cas_attestation_fault) {
            this.task_code = String(TaskStatus.CAS_ATTESTATION_FAULT);
            this.task_result = `CAS_ATTESTATION_FAULT: ${this.cas_attestation_fault} -- ` +
                `the operator provisioned this task through a CAS that failed ` +
                `self-attestation; order terminated for refund.`;
            return;
        }
        const payload_data = await this.getFileContentAndDecrypt(this.etny_bucket, this.payload);
        const input_data = await this.getFileContentAndDecrypt(this.etny_bucket, this.input);

        // THE HANDOVER IS ALWAYS SIGNED: the trustedzone signs the payload
        // and input it forwards, and this enclave refuses an unverifiable
        // handover -- the operator's storage layer between the enclaves must
        // not be able to substitute either. Mirrors the pynithy
        // validate_trustedzone_data behavior.
        const payloadSig = await this.getFileContentAndDecrypt(this.etny_bucket, this.payload + '.sig');
        const inputSig = await this.getFileContentAndDecrypt(this.etny_bucket, this.input + '.sig');
        if (payloadSig === false ||
            !etny_crypto.verifySignature(this.trustedZonePublicKey, String(payload_data), String(payloadSig))) {
            console.log('Payload signature validation FAILED');
            this.task_code = TaskStatus.SIGNATURE_ERROR;
            this.task_result = 'INVALID PAYLOAD SIGNATURE';
            return false;
        }
        if (inputSig === false ||
            !etny_crypto.verifySignature(this.trustedZonePublicKey, String(input_data), String(inputSig))) {
            console.log('Input signature validation FAILED');
            this.task_code = TaskStatus.SIGNATURE_ERROR;
            this.task_result = 'INVALID INPUT SIGNATURE';
            return false;
        }
        console.log('Trustedzone handover signatures validated successfully');

        console.log('Validating client payload and input...');
        await this.validateClientPayload(payload_data, input_data);

        if (this.is_valid_client_data) {
            console.log('Client payload and input are valid');
        } else {
            console.log('Client payload and input are NOT valid');
            return false;
        }

        // Attested task caller: the DO-request owner, forwarded by the
        // trustedzone as caller.securelock + .sig. Accepted ONLY with a valid
        // trustedzone signature -- this build's crypto module has no verify
        // helper yet, so until one lands the caller stays unset (anonymous)
        // rather than trusting an unverifiable value.
        this.task_caller = null;
        try {
            const callerValue = await this.getFileContentAndDecrypt(this.etny_bucket, 'caller.securelock');
            const callerSig = await this.getFileContentAndDecrypt(this.etny_bucket, 'caller.securelock.sig');
            if (typeof etny_crypto.verifySignature === 'function') {
                if (etny_crypto.verifySignature(this.trustedZonePublicKey, callerValue, callerSig)) {
                    this.task_caller = String(callerValue).trim();
                    console.log(`Task caller attested by trustedzone: ${this.task_caller}`);
                } else {
                    console.error('caller.securelock signature validation FAILED; treating task as anonymous');
                }
            } else {
                console.log('No signature-verify support in this build; ignoring caller.securelock (anonymous)');
            }
        } catch (e) {
            console.log('No attested task caller supplied; treating task as anonymous');
        }

        this.configureStateRegistry();

        // Interactive session: the trustedzone stages session.config when the
        // request asked for one; the executor keeps the payload context alive,
        // streams inputs/outputs, and finalizes with a SUCCESS summary when
        // the running period completes (see etny_session_exec).
        let task_result;
        let sessionMode = false;
        try {
            const r = await this.swiftStreamService.isObjectInBucket(
                this.etny_bucket, 'session.config.securelock');
            sessionMode = Boolean(r[1]);
        } catch (e) { sessionMode = false; }
        if (sessionMode) {
            const { runSession } = require('./etny_session_exec');
            console.log('Interactive session mode');
            task_result = await runSession(this, payload_data, input_data);
        } else {
            task_result = await executeTask(payload_data, input_data);
        }
        console.log('TASK RESULT (code, data):', task_result);
        this.task_code = task_result[0];
        this.task_result = task_result[1];

        // Post-payload: re-assert the attested caller across the ESR ledger from
        // THIS securelock's private copy (this.task_caller), captured before the
        // payload ran and never handed to the payload. Corrects any callerUsed
        // the payload may have forged (so the trustedzone reads the truth) and
        // fails the task locally if a forgery is detected. Defence in depth;
        // the trustedzone (separate enclave) and the CID-bound caller remain the
        // authoritative layers. The re-stamped ledger and the task binding are
        // then attested inside the result envelope saveResult() signs, so the
        // trustedzone reads them from the signature rather than from the
        // node's storage.
        let ledgerAttestation = null;
        try {
            const ecld_state = require("./ecld_state");
            if (typeof ecld_state.restampLedgerCaller === 'function') {
                const tampered = await ecld_state.restampLedgerCaller(this.task_caller || null);
                if (tampered) {
                    console.error('ESR ledger caller was tampered with by the payload -- failing the task (SECURITY_VIOLATION).');
                    this.task_code = TaskStatus.SECURITY_VIOLATION;
                    this.task_result = 'SECURITY_VIOLATION: the task attempted to forge the state commit caller. The attested submitter was re-asserted and the task was terminated.';
                }
            }
            if (typeof ecld_state.ledgerAttestation === 'function') {
                ledgerAttestation = ecld_state.ledgerAttestation();
            }
        } catch (e) {
            console.error('ESR ledger re-stamp skipped:', e && e.message ? e.message : e);
        }
        this.task_result = attachTaskAttestation(this.task_result, ledgerAttestation, this.task_binding);

        return true;
    }

}

// Attests this securelock's view of the task inside the result envelope the
// identity key signs in saveResult(). esr.wallet is the enclave's ESR address
// and esr.commits the signed authorization records it staged (the same
// objects staged to esr.authorizations.json), taken AFTER restampLedgerCaller
// so they carry the attested caller; the payload's own entries are kept.
// order_id and challenge are the task binding the trustedzone forwarded, so a
// client can check the decrypted result against the on-chain result record.
// Only an ecld envelope can carry them; any other result (legacy plain text,
// or the SECURITY_VIOLATION text) is returned unchanged, as is an envelope
// when there is nothing to attest.
function attachTaskAttestation(taskResult, attestation, binding) {
    const hasLedger = !!(attestation && attestation.wallet);
    if (!hasLedger && !binding) return taskResult;
    let envelope;
    try { envelope = JSON.parse(String(taskResult)); } catch (e) { return taskResult; }
    if (!envelope || typeof envelope !== 'object' || envelope.ecld !== 1) return taskResult;
    if (hasLedger) {
        const entries = envelope.esr && Array.isArray(envelope.esr.entries) ? envelope.esr.entries : [];
        envelope.esr = { wallet: attestation.wallet, entries, commits: attestation.commits };
    }
    if (binding) {
        envelope.order_id = binding.order_id;
        envelope.challenge = binding.challenge;
    }
    return JSON.stringify(envelope);
}

function initSwiftStreamClient() {
    console.log('Initializing SwiftStream Service...');
    const swiftStreamClient = new SwiftStreamService(
        EtnySecureLock.debug ? "localhost" : "etny-swift-stream",
        9000,
        "swiftstreamadmin",
        "swiftstreamadmin");
    console.log('SwiftStream Service started.');
    console.log('################################');

    return swiftStreamClient;
}

// Set as soon as the enclave object exists so the top-level catch can report a
// failure result even when the throw happens deep inside execute().
let currentApp = null;

/**
 * Best-effort: write a failure result so the trustedzone stops waiting.
 *
 * Securelock only publishes the result and its code; the trustedzone reads
 * those and builds the signed transaction. Without them that wait runs to its
 * timeout and the whole order stalls with no diagnosis.
 *
 * Guarded throughout: this runs while already handling a failure, so it must
 * never throw or hang.
 */
async function reportFailure(app, err) {
    if (!app) {
        console.log('cannot report failure: enclave died before initialization');
        return;
    }
    try {
        // Keep a specific code if one was already set (checksum mismatch, ...).
        if (app.task_code === undefined || app.task_code === null || app.task_code === '') {
            app.task_code = TaskStatus.SYSTEM_ERROR;
        }
        if (!app.task_result) {
            app.task_result = `ENCLAVE ERROR: ${err && err.message ? err.message : err}`;
        }
        await app.saveResult();
        console.log(`failure reported (task_code=${app.task_code})`);
    } catch (reportErr) {
        console.log('could not report the failure result:', reportErr);
    }
}

async function execute() {
    console.log('########################################');
    console.log('########################################');
    console.log('########## [ETNY SecureLock] ##########');
    console.log('########################################');
    console.log('########################################');
    console.log('');
    console.log('');
    console.log('');

    const swiftStreamClient = initSwiftStreamClient();

    const app = new EtnySecureLock(swiftStreamClient);
    // Exposed so the top-level handler can still publish a failure result if
    // anything below throws (see reportFailure).
    currentApp = app;

    // Testnet: materialize the self-signed cert/key from MR_ENCLAVE into the
    // file paths before anything reads them (harvest + decrypt). No-op on mainnet
    // (CAS provides those files).
    app.generateSelfSignedCertIfTestnet();

    const hasReadEnvFile = await app.readEnv();
    if (!hasReadEnvFile && !EtnySecureLock.debug) {
        console.log(`Failed reading .env file.`);
        await app.savePublicCert();
        return;
    }

    if (process.env.ETNY_MODE === "PUBLIC_KEY") {
        await app.savePublicCert();
    } else {
        console.log('Creating the application...');
        const created = await app.create();

        if (!created) {
            console.log(`Failed at creation step, not able decoding input metadata, exiting.`);
            return;
        }

        console.log('Waiting for payload and input to be downloaded...');
        await app.waitForPayloadAndInput();

        if (app.is_valid_client_data) {
            console.log('Executing client code...');
            const wasExecuted = await app.execute();
            if (!wasExecuted) {
                console.log('Failed execution of SecureLock enclave.')
                // Still hand over the (signed) failure result -- the
                // trustedzone must see the task code (e.g. SIGNATURE_ERROR)
                // instead of waiting for a result that never comes.
                await app.saveResult();
                return;
            }
        } else {
            console.log(`Failed client payload and input validation, ${app.task_result}, exiting.`);
            return;
        }

        await app.saveResult();
        console.log('Finished process.');
    }
}

(async () => {
    try {
        await execute();
    } catch (e) {
        console.log(e);
        await reportFailure(currentApp, e);
        process.exitCode = 1;
    }
})();
