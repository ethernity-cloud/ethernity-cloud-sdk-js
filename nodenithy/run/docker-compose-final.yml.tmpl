version: '3.2'
services:
  las:
    container_name: las
    privileged: true
    image: localhost:5000/etny-las
    entrypoint: "/las_entrypoint.sh"
    # -a 0.0.0.0: without it the LAS binds dual-stack (:::18766) and cannot
    # allocate the socket on a host booted with ipv6.disable=1, so it
    # crash-loops and every task on that node times out with no attestation.
    # The enclaves reach it over IPv4 either way.
    command: "/usr/local/bin/las -a 0.0.0.0"
    networks:
      - ethernity
    devices:
      - "/dev/sgx_enclave:/dev/sgx_enclave"
    restart: on-failure
    ports:
      - target: 18766
        published: 18766
        protocol: tcp
        mode: host

  etny-securelock:
    container_name: etny-securelock
    privileged: true
    image: localhost:5000/etny-securelock
    entrypoint: ""
    command: [ "/usr/local/bin/node", "/etny-securelock/securelock.js" ]
    environment:
      - SCONE_CAS_ADDR=scone-cas.cf
      - SCONE_LAS_ADDR=las
      - SCONE_CONFIG_ID=__ENCLAVE_NAME_SECURELOCK__/application
      - SCONE_HEAP=1024M
      # Must match the --stack the securelock binary was signed with (build.mjs),
      # otherwise SCONE recomputes MRENCLAVE at load and re-signs as debug.
      - SCONE_STACK=4M
      - SCONE_LOG=DEBUG
      - SCONE_ALLOW_DLOPEN=1
      - SCONE_EXTENSIONS_PATH=/lib/libbinary-fs.so
    restart: on-failure
    networks:
      - ethernity
    devices:
      - "/dev/sgx_enclave:/dev/sgx_enclave"
    depends_on:
      - las

  etny-trustedzone:
    container_name: etny-trustedzone
    privileged: true
    image: localhost:5000/etny-trustedzone
    entrypoint: ""
    command: [ "/usr/local/bin/node", "/etny-trustedzone/trustedzone.js" ]
    environment:
      - SCONE_CAS_ADDR=scone-cas.cf
      - SCONE_LAS_ADDR=las
      - SCONE_CONFIG_ID=__ENCLAVE_NAME_TRUSTEDZONE__/application
      - SCONE_HEAP=256M
      - SCONE_LOG=DEBUG
      - SCONE_ALLOW_DLOPEN=1
      - SCONE_EXTENSIONS_PATH=/lib/libbinary-fs.so
    restart: on-failure
    networks:
      - ethernity
    devices:
      - "/dev/sgx_enclave:/dev/sgx_enclave"
    depends_on:
      - las
networks:
  ethernity:
    external: true
