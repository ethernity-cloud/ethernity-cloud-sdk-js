    def _cas_endpoints_from_chain(self, cas_address):
        """Endpoints for a CAS, read FROM CHAIN -- never from the environment.

        The node operator controls the host and everything the enclave is
        handed, so the address to dial must come from the ValidatorRegistry
        itself. /onion3 is preferred, then the rest, matching the node-side
        resolver. Returns REST base URLs.
        """
        vr_abi = [
            {"name": "multiaddrsOf", "type": "function", "stateMutability": "view",
             "inputs": [{"type": "address"}], "outputs": [{"type": "string[]"}]},
        ]
        vr = self.w3.eth.contract(
            address=self.w3.toChecksumAddress(self.validator_registry_address),
            abi=vr_abi)
        try:
            mas = vr.caller().multiaddrsOf(self.w3.toChecksumAddress(cas_address))
        except Exception as e:
            print(f'CAS attestation: multiaddrsOf failed: {e}')
            return []
        onion, rest = [], []
        for ma in mas:
            parts = [p for p in str(ma).split('/') if p]
            if len(parts) != 4 or parts[2] != 'tcp':
                continue
            kind, host, port = parts[0], parts[1], parts[3]
            try:
                port = int(port)
            except ValueError:
                continue
            # REST pairing convention: rest = 8081 + (enclave - 18765)
            rest_port = 8081 + (port - 18765) if 18765 <= port < 18965 else 8081
            if kind == 'onion3':
                host = host if host.endswith('.onion') else host + '.onion'
                onion.append(f'http://{host}:{rest_port}')
            elif kind in ('dns4', 'dns6', 'dns', 'ip4', 'ip6'):
                rest.append(f'http://{host}:{rest_port}')
        return onion + rest

    def challenge_cas(self, cas_address, registered_mrenclave, registered_cert):
        """
        ENCLAVE-INITIATED CAS attestation: prove the CAS is live NOW.

        The CAS is remote and the operator sits on the path, so the injected
        environment alone cannot prove liveness. The CAS minted a RANDOM
        session id (ECAS_ATTEST_SESSION) it holds OPEN; we resolve its
        endpoint FROM CHAIN, present that id with a nonce WE choose, and it
        returns a FRESH quote binding
        sha256(session || nonce || cas_addr || cert_hash). A captured
        environment stops working when its session closes; a captured
        RESPONSE cannot match a different nonce. Returns None on success,
        else the failure reason.
        """
        session_id = os.environ.get('ECAS_ATTEST_SESSION', '')
        if not session_id:
            return 'no ECAS_ATTEST_SESSION in the environment (CAS cannot be challenged)'
        nonce = secrets.token_bytes(32)
        # Echo back the nonce the CAS injected, so the SAME fresh quote also
        # re-attests the environment we were handed (report_data[52:64]). The
        # CAS recomputes the injected commitment from its own address and cert
        # -- we supply only the nonce -- so this cannot be steered.
        env_nonce_hex = os.environ.get('ECAS_ENCLAVE_NONCE', '')
        payload = json.dumps({'session': session_id, 'nonce': nonce.hex(),
                              'env_nonce': env_nonce_hex}).encode()



        endpoints = self._cas_endpoints_from_chain(cas_address)
        if not endpoints:
            return 'the CAS publishes no dialable endpoint on chain'
        last = 'no endpoint answered'
        for base in endpoints:
            url = f'{base}/attest/session'
            try:
                req = urllib.request.Request(
                    url, data=payload, headers={'Content-Type': 'application/json'})
                with urllib.request.urlopen(req, timeout=20) as r:
                    doc = json.loads(r.read().decode('utf-8', 'replace'))
            except Exception as e:
                last = f'{url}: {e}'
                continue
            try:
                quote = bytes.fromhex(doc.get('quote', ''))
            except ValueError:
                return f'{url}: challenge quote is not hex'
            if len(quote) < 48 + 384:
                return f'{url}: challenge quote too short ({len(quote)} bytes)'
            rd = quote[368:432]
            got_addr = '0x' + rd[32:52].hex()
            if got_addr.lower() != cas_address.lower():
                return (f'challenge quote names {got_addr}, not the CAS '
                        f'{cas_address} we verified on chain')
            expect = hashlib.sha256(
                session_id.encode() + nonce
                + bytes.fromhex(cas_address[2:]) + bytes.fromhex(registered_cert)
            ).digest()
            if rd[0:32] != expect:
                return ('challenge commitment mismatch: the CAS did not sign '
                        'our session+nonce (stale or replayed response)')
            # ENVIRONMENT RE-ATTESTATION. When we sent env_nonce, the fresh
            # quote must also carry the head of the commitment that went into
            # ECAS_CAS_QUOTE. This is what ties the two quotes together: a live
            # CAS confirming, under a NEW signature, that the environment we
            # hold is the one it sent. Without it the challenge proved only
            # that some CAS was alive.
            if env_nonce_hex:
                env_expect = hashlib.sha256(
                    session_id.encode() + bytes.fromhex(env_nonce_hex)
                    + bytes.fromhex(cas_address[2:])
                    + bytes.fromhex(registered_cert)).digest()
                if rd[52:64] != env_expect[0:12]:
                    return ('the CAS did not confirm the environment it sent: '
                            f'fresh quote carries {rd[52:64].hex()}, expected '
                            f'{env_expect[0:12].hex()}')
                print('CAS re-attested the injected environment under a '
                             'fresh signature')
            qmr = quote[112:144].hex()
            if qmr.lower() != registered_mrenclave.lower():
                return (f'challenge quote MRENCLAVE {qmr} != registered '
                        f'{registered_mrenclave}')
            print(
                f'CAS CHALLENGE PASSED: {base} signed our session+nonce with a '
                f'fresh quote (MRENCLAVE {qmr[:16]}...)')
            return None
        return f'CAS challenge failed: {last}'

    def verify_cas_attestation(self):
        """
        Verify the CAS that provisioned this enclave. The CAS injects
        ECAS_CAS_QUOTE (a DCAP quote binding its EGETKEY validator address at
        report_data[0:20] and the SHA-256 of its certificate at [20:52]); we
        check it against the ValidatorRegistry baked into this build: active
        validator, registered MRENCLAVE match, registered certHash match.
        Evicting a CAS on-chain revokes it here on the next task. STRICT: a
        missing quote, an invalid one, and an unreachable registry are all
        the same terminal fault (refund); there is no softening knob. The quote's ECDSA/PCK
        chain is not verified in-enclave yet; the binding is quote-contents
        <-> on-chain record (the revocation path).
        """
        registry = self.validator_registry_address
        self.cas_attestation_fault = None

        def fault(reason):
            # TERMINAL: registry present -> a CAS quote is MANDATORY, so a
            # MISSING quote is as damning as a wrong one. The operator provisioned this task through an
            # impostor CAS. Recorded here and adjudicated before the payload
            # runs -- the task then terminates with CAS_ATTESTATION_FAULT
            # (40) and the order is refunded.
            print(f'CAS ATTESTATION INVALID: {reason}')
            self.cas_attestation_fault = reason

        if not registry or registry.startswith('__'):
            print('CAS attestation: no ValidatorRegistry for this network; skipping')
            return
        quote_b64 = os.environ.get('ECAS_CAS_QUOTE', '')
        if not quote_b64:
            return fault('no ECAS_CAS_QUOTE in the session environment (unattested CAS)')
        try:
            quote = base64.b64decode(quote_b64)
        except Exception as e:
            return fault(f'ECAS_CAS_QUOTE is not valid base64: {e}')
        # DCAP quote layout: 48-byte header; report body: ATTRIBUTES at
        # body+48 (16), MRENCLAVE at body+64 (32), report_data at body+320 (64).
        if len(quote) < 48 + 384:
            return fault(f'quote too short ({len(quote)} bytes)')
        attributes = quote[96:112]
        quote_mrenclave = quote[112:144].hex()
        report_data = quote[368:432]

        vr_abi = [
            {"name": "isValidator", "type": "function", "stateMutability": "view",
             "inputs": [{"type": "address"}], "outputs": [{"type": "bool"}]},
            {"name": "validators", "type": "function", "stateMutability": "view",
             "inputs": [{"type": "address"}],
             "outputs": [{"name": "mrenclave", "type": "bytes32"},
                         {"name": "certHash", "type": "bytes32"},
                         {"name": "active", "type": "bool"},
                         {"name": "admittedBlock", "type": "uint64"},
                         {"name": "lastVoteBlock", "type": "uint64"}]},
        ]
        last_err = None
        cas_address, bound_cert, active, record = None, None, False, None
        for _attempt in range(3):
            try:
                vr = self.w3.eth.contract(address=self.w3.toChecksumAddress(registry),
                                          abi=vr_abi)
                # Whichever layout names an ACTIVE validator is the real one.
                for cand_addr, cand_cert in cas_candidates:
                    if vr.caller().isValidator(cand_addr):
                        cas_address, bound_cert = cand_addr, cand_cert
                        active = True
                        record = vr.caller().validators(cand_addr)
                        break
                if not active:
                    # Both layouts resolved to non-validators: report the
                    # fresh-layout address, which is what a current CAS sends.
                    cas_address, bound_cert = cas_candidates[0]
                last_err = None
                break
            except Exception as e:
                last_err = e
                time.sleep(5)
        if last_err is not None:
            # The enclave already depends on this chain for its order
            # metadata, so an unreachable registry is not a new fragility --
            # and treating it softly would let an operator bypass the check
            # by firewalling the RPC.
            return fault(f'ValidatorRegistry {registry} unreachable after 3 attempts: {last_err}')
        if not active:
            return fault(f'CAS {cas_address} is NOT an active validator')
        registered_mr = record[0].hex()
        if registered_mr != quote_mrenclave:
            return fault(f'CAS quote MRENCLAVE {quote_mrenclave} != registered {registered_mr}')
        registered_cert = record[1].hex()
        if bound_cert is not None:
            # Legacy layout: the cert hash is a readable field, compare it.
            if registered_cert != '00' * 32 and registered_cert != bound_cert:
                return fault(f'CAS quote cert hash {bound_cert} != registered {registered_cert}')
        else:
            # FRESH layout: the cert hash is not a readable field -- it is
            # folded into report_data[0:32] together with the attestation
            # SESSION ID and this enclave's own nonce. Recomputing that
            # commitment is what binds the injected ENVIRONMENT AS ONE UNIT:
            # ECAS_ATTEST_SESSION, ECAS_ENCLAVE_NONCE and ECAS_CAS_QUOTE only
            # agree if the CAS minted all three together for THIS session. An
            # operator who strips the session id, swaps in another enclave's
            # id, or pairs a captured quote with a fresh session breaks the
            # hash -- and cannot repair it, because the commitment is inside
            # an SGX signature.
            #
            # The nonce is echoed by the CAS because SCONE gives the enclave
            # no way to read its own attestation report_data. Echoing costs
            # nothing: a tampered nonce simply fails to reproduce [0:32].
            if registered_cert == '00' * 32:
                # Without a registered cert there is nothing to recompute
                # against, so the binding cannot be proven. Tolerating that
                # would hand every CAS an opt-out: leave certHash unset and
                # the strongest check silently disappears.
                return fault(f'CAS {cas_address} has no certHash registered; '
                             'the fresh quote binding cannot be verified')
            session_id = os.environ.get('ECAS_ATTEST_SESSION', '')
            nonce_hex = os.environ.get('ECAS_ENCLAVE_NONCE', '')
            if not session_id:
                return fault('fresh CAS quote but no ECAS_ATTEST_SESSION '
                             '(environment was tampered with)')
            if not nonce_hex:
                return fault('fresh CAS quote but no ECAS_ENCLAVE_NONCE '
                             '(environment was tampered with)')
            try:
                nonce = bytes.fromhex(nonce_hex)
            except ValueError as e:
                return fault(f'ECAS_ENCLAVE_NONCE is not hex: {e}')
            expected = hashlib.sha256(
                session_id.encode()
                + nonce
                + bytes.fromhex(cas_address[2:])
                + bytes.fromhex(registered_cert)).digest()
            if expected != report_data[0:32]:
                return fault(
                    'CAS quote does not commit to the injected environment '
                    f'(session {session_id[:16]}..., expected '
                    f'{expected.hex()[:16]}..., quote carries '
                    f'{report_data[0:32].hex()[:16]}...)')
            print('CAS environment binding OK: quote commits to '
                         f'attestation session {session_id[:16]}...')
        # SGX ATTRIBUTES.FLAGS bit 1 = DEBUG. Tolerated only when the session
        # explicitly says so (testnet debug CAS).
        if (attributes[0] & 0x02) and '__NETWORK_TYPE__' != 'testnet':
            return fault('CAS enclave runs in SGX DEBUG mode')
        print(f'CAS ATTESTATION VERIFIED: validator {cas_address}, '
              f'MRENCLAVE {quote_mrenclave[:16]}..., certificate bound on-chain')

        # LIVENESS. Everything above proves the injected quote matches an
        # on-chain record -- but the environment was handed to us by the node.
        # Challenge the CAS ourselves over an endpoint resolved FROM CHAIN,
        # with a nonce we pick, so nothing replayed can pass. Same terminal
        # fault (refund) as any other CAS-attestation failure.
        challenge_error = self.challenge_cas(
            cas_address, registered_mr, registered_cert)
        if challenge_error is not None:
            return fault(challenge_error)

    def read_contract_abi(self):
        self.contract_abi = self.__read_contract_abi('pox.abi')
        self.image_registry_abi = self.__read_contract_abi('image_registry.abi')

    def __read_contract_abi(self, contract_name):
        f = open(os.path.dirname(os.path.realpath(__file__)) + f'/{contract_name}')
        contract_abi = f.read()
        f.close()
        return contract_abi

    def __load_env(self):
        if os.getenv('ETNY_CHAIN_ID') is not None:
            self.chain_id = int(os.getenv('ETNY_CHAIN_ID'))

        if os.getenv('ETNY_SMART_CONTRACT_ADDRESS') is not None:
            self.smart_contract_address = os.getenv('ETNY_SMART_CONTRACT_ADDRESS').rstrip()

        if os.getenv('ETNY_WEB3_PROVIDER') is not None:
            self.web3_provider = os.getenv('ETNY_WEB3_PROVIDER').rstrip()

        self.client_challenge = os.getenv('ETNY_CLIENT_CHALLENGE')
        self.order_id = int(os.getenv('ETNY_ORDER_ID'))

    def read_client_challenge(self):
        self.encrypted_tuple = crypto.encrypted_data_from_base64_json(self.client_challenge)

    def generate_challenge(self, length=20):
        lowercase_only = ''.join(
            random.choice(string.ascii_lowercase) for _ in range(length)
        )
        #print('random challenge:', lowercase_only)
        self.enclave_challenge = lowercase_only
        return self.enclave_challenge

    def build_result(self):
        self.result = (f'{self.version}:{self.task_code}:{self.task_result_checksum}:{self.enclave_challenge}:')

    def addResult(self):
        self.build_result()
        print(f'adding result to order {self.order_id}')
        nonce = self.w3.eth.getTransactionCount(self.publickey)
        unicorn_txn = self.etny.functions._addResultToOrder(
            self.order_id, self.result
        ).buildTransaction({
            'gas': 1000000,
            'chainId': self.chain_id,
            'nonce': nonce,
            'gasPrice': self.w3.toWei("1", "mwei"),
        })

        signed_txn = self.w3.eth.account.sign_transaction(unicorn_txn, private_key=self.acct.key)
        self.w3.eth.sendRawTransaction(signed_txn.rawTransaction)
        # self.transaction = unicorn_tx signed
        hash = self.w3.toHex(self.w3.sha3(signed_txn.rawTransaction))

        try:
            receipt = self.w3.eth.waitForTransactionReceipt(hash)
        except Exception as e:
            print(f'An error occurred while sending transaction result {self.order_id}: ', e)
            raise

        #print('transaction status: ', receipt.status)
        #print('transaction receipt: ', receipt)
        if receipt.status == 1:
            print("Result transaction was successful!")
        else:
            print("Result transaction was UNSUCCESSFUL!")

        #print("Result payload: %s" % self.result)
        #print("TX Raw: %s" % signed_txn.rawTransaction)
        #print("TX Hash: %s" % hash)

    def build_transaction(self):
        self.build_result()
        print(f'adding result to order {self.order_id}')
        nonce = self.w3.eth.getTransactionCount(self.publickey)
        unicorn_txn = self.etny.functions._addResultToOrder(
            self.order_id, self.result
        ).buildTransaction({
            'gas': 1000000,
            'chainId': self.chain_id,
            'nonce': nonce,
            'gasPrice': self.w3.toWei("1", "mwei"),
        })

        signed_txn = self.w3.eth.account.sign_transaction(unicorn_txn, private_key=self.acct.key)
        signed_tx_as_bytes = binascii.hexlify(signed_txn.rawTransaction)
        self.signed_tx_as_bytes = signed_tx_as_bytes

    def get_result_checksum(self):
        self.task_result_checksum = hashlib.sha256(self.task_result.encode("utf-8")).hexdigest()

    def save_result(self):
        self.__get_latest_trusted_zone_public_key()
        self.encrypt_file_and_push_to_swifstream(str(self.task_result), "result.txt")
        self.encrypt_file_and_push_to_swifstream(str(self.task_code), "result_code.txt")

    def save_pub_cert(self):
        self.swift_stream_service.create_bucket(self.etny_bucket)
        self.swift_stream_service.put_file_content(self.etny_bucket,
                                                   "cert.pem",
                                                   self.cert_file)

    def save_transaction(self):
        self.swift_stream_service.create_bucket(self.etny_bucket)
        transaction = io.BytesIO(self.signed_tx_as_bytes)
        self.swift_stream_service.put_file_content(self.etny_bucket,
                                                   "transaction.txt",
                                                   self.transaction_file,
                                                   transaction)

    def execute(self):
        # ADJUDICATE the CAS attestation verdict recorded at startup. An
        # INVALID CAS quote terminates the task before the payload runs; the
        # result (code 40, CAS_ATTESTATION_FAULT) is saved by the normal
        # save_result() path and forwarded on-chain by the trustedzone --
        # the refundable operator-fault path.
        if getattr(self, 'cas_attestation_fault', None):
            self.task_code = '40'
            self.task_result = (
                f'CAS_ATTESTATION_FAULT: {self.cas_attestation_fault} -- the '
                f'operator provisioned this task through a CAS that failed '
                f'self-attestation; order terminated for refund.')
            return

        payload_data = self.__get_file_content_and_decrypt(self.payload)
        input_data = self.__get_file_content_and_decrypt(self.input)
        print('Validate client payload and input')
        self.validate_client_payload(payload_data, input_data)
        if app.is_valid_client_data:
            print('Client payload and input are valid')
        else:
            print('Client payload and input are NOT valid')
            return

        task_result = execute_task(payload_data, input_data)
        print('TASK RESULT (code, data):', task_result)
        self.task_code = str(task_result[0])
        self.task_result = task_result[1]

    def __get_file_content_and_decrypt(self, object_name):
        status, encrypted_base64 = self.swift_stream_service.get_file_content(self.etny_bucket, object_name)
        if not status:
            print(f'Failed to get {object_name} file')
            raise Exception(f'Failed to get {object_name} file')

        encrypted_tuple = crypto.encrypted_data_from_base64_json(encrypted_base64.encode('utf-8'))
        decrypted_result = crypto.decrypt(self.key_file, encrypted_tuple)
        return decrypted_result.decode('utf-8')

    def encrypt_file_and_push_to_swifstream(self, file_data, file_name):
        encrypted_input = crypto.encrypt_with_pub_key(self.trusted_zone_public_key, file_data.encode('utf-8'))
        encrypted_input_base64 = crypto.encrypted_data_to_base64_json(encrypted_input)

        # file name should end with secure lock '.securelock' extension
        file_name = file_name + '.securelock'
        self.swift_stream_service.create_bucket(self.etny_bucket)
        data = io.BytesIO(encrypted_input_base64)
        status, _ = self.swift_stream_service.put_file_content(self.etny_bucket,
                                                               file_name,
                                                               "",
                                                               data)
        if status:
            print(f'File {file_name} encrypted and saved to swift stream successfully')

    def __get_trusted_zone_public_key(self):
        print('getting the public key of the trusted zone enclave')
        image_hash = self._metadata.image_hash
        if EtnySecureLock.debug:
            image_hash = 'v3-hash-1'
        self.trusted_zone_public_key = self.image_registry.caller().getTrustedZoneImageCertPublicKey(
            image_hash)

    def __get_latest_trusted_zone_public_key(self):
        print('getting latest public key of the trusted zone enclave')
        self.trusted_zone_public_key = self.image_registry.caller().getLatestTrustedZoneImageCertPublicKey(
            '__TRUSTED_ZONE_IMAGE__', 'v3')[1]


