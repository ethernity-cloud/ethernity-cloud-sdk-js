version: '3.2'

services:
  minio:
    container_name: etny-swift-stream
    # quay.io/minio/minio:RELEASE.2023-03-13T19-46-17Z, mirrored on 2026-10-13
    # (image id c69ff79d5831): quay.io answers 401 to an anonymous pull of
    # that tag, and the mirror is pulled without credentials.
    image: registry.ethernity.cloud:443/debuggingdelight/ethernity-cloud-sdk-registry/minio/minio:RELEASE.2023-03-13T19-46-17Z
    command: server /data/
    expose:
      - "9000"
    ports:
      - "0.0.0.0:9000:9000"
    environment:
      MINIO_ROOT_USER: swiftstreamadmin
      MINIO_ROOT_PASSWORD: swiftstreamadmin
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://docker:9000/minio/health/live" ]
      interval: 30s
      timeout: 20s
      retries: 3
#    networks:
#      - ethernity
#    volumes:
#      - etny-swift-stream-data:/data

